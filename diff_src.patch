diff --git a/src/module/quotation/features/quotations/components/legal-block-extension.test.ts b/src/module/quotation/features/quotations/components/legal-block-extension.test.ts
new file mode 100644
index 0000000..61fc5c1
--- /dev/null
+++ b/src/module/quotation/features/quotations/components/legal-block-extension.test.ts
@@ -0,0 +1,129 @@
+import { Editor } from '@tiptap/core';
+import assert from 'node:assert/strict';
+import { it, describe } from 'node:test';
+import StarterKit from '@tiptap/starter-kit';
+import { Selection } from '@tiptap/pm/state';
+
+import { LegalBlockExtension } from './legal-block-extension.ts';
+
+describe('LegalBlockExtension', () => {
+  const initialContent = {
+    type: 'doc',
+    content: [
+      {
+        type: 'paragraph',
+        content: [{ type: 'text', text: 'Opening paragraph before legal block' }],
+      },
+      {
+        type: 'legalBlock',
+        attrs: { 'data-block-type': 'legal' },
+        content: [
+          {
+            type: 'paragraph',
+            content: [{ type: 'text', text: 'Official legal terms and conditions.' }],
+          },
+        ],
+      },
+      {
+        type: 'paragraph',
+        content: [{ type: 'text', text: 'Closing paragraph after legal block' }],
+      },
+    ],
+  };
+
+  function createTestEditor(options: { unlocked: boolean }) {
+    const editor = new Editor({
+      extensions: [
+        StarterKit,
+        LegalBlockExtension.configure({ unlocked: options.unlocked }),
+      ],
+      content: initialContent,
+    });
+    // In headless test mode without DOM mount, activate plugins on editor state
+    const stateWithPlugins = editor.state.reconfigure({
+      plugins: editor.extensionManager.plugins,
+    });
+    editor.view.updateState(stateWithPlugins);
+    return editor;
+  }
+
+  it('rejects text insertion inside legal block when locked', () => {
+    const editor = createTestEditor({ unlocked: false });
+
+    let legalPos = -1;
+    editor.state.doc.descendants((node, pos) => {
+      if (node.type.name === 'legalBlock') {
+        legalPos = pos + 2; // inside the inner paragraph text
+      }
+    });
+    assert.ok(legalPos > 0, 'legalBlock node must be found in doc');
+
+    const jsonBefore = JSON.stringify(editor.getJSON());
+    
+    // Attempt to insert text inside legal block
+    const tr = editor.state.tr.insertText('TAMPERED ', legalPos);
+    (editor as any).dispatchTransaction(tr);
+
+    const jsonAfter = JSON.stringify(editor.getJSON());
+    assert.equal(jsonAfter, jsonBefore, 'Content inside legal block must NOT change when locked');
+    assert.ok(!jsonAfter.includes('TAMPERED'), 'Document must not contain tampered text');
+    
+    editor.destroy();
+  });
+
+  it('allows text insertion outside legal block when locked', () => {
+    const editor = createTestEditor({ unlocked: false });
+
+    const jsonBefore = JSON.stringify(editor.getJSON());
+
+    // Insert text in the first paragraph (pos = 1)
+    const tr = editor.state.tr.insertText('EDITED ', 1);
+    (editor as any).dispatchTransaction(tr);
+
+    const jsonAfter = JSON.stringify(editor.getJSON());
+    assert.notEqual(jsonAfter, jsonBefore, 'Content outside legal block must change when edited');
+    assert.ok(jsonAfter.includes('EDITED Opening paragraph'), 'Document must contain edited opening text');
+
+    editor.destroy();
+  });
+
+  it('allows text insertion inside legal block when unlocked', () => {
+    const editor = createTestEditor({ unlocked: true });
+
+    let legalPos = -1;
+    editor.state.doc.descendants((node, pos) => {
+      if (node.type.name === 'legalBlock') {
+        legalPos = pos + 2;
+      }
+    });
+    assert.ok(legalPos > 0, 'legalBlock node must be found in doc');
+
+    const tr = editor.state.tr.insertText('UNLOCKED_EDIT ', legalPos);
+    (editor as any).dispatchTransaction(tr);
+
+    const jsonAfter = JSON.stringify(editor.getJSON());
+    assert.ok(jsonAfter.includes('UNLOCKED_EDIT Official legal'), 'Document must contain modified legal text when unlocked');
+
+    editor.destroy();
+  });
+
+  it('allows selection and cursor transactions inside legal block when locked', () => {
+    const editor = createTestEditor({ unlocked: false });
+
+    let legalPos = -1;
+    editor.state.doc.descendants((node, pos) => {
+      if (node.type.name === 'legalBlock') {
+        legalPos = pos + 2;
+      }
+    });
+
+    // Move selection into legal block
+    const tr = editor.state.tr.setSelection(
+      Selection.near(editor.state.doc.resolve(legalPos))
+    );
+    (editor as any).dispatchTransaction(tr);
+    assert.equal(editor.state.selection.from, legalPos, 'Cursor selection inside legal block must be allowed');
+
+    editor.destroy();
+  });
+});
diff --git a/src/module/quotation/features/quotations/components/legal-block-extension.ts b/src/module/quotation/features/quotations/components/legal-block-extension.ts
new file mode 100644
index 0000000..554aa1c
--- /dev/null
+++ b/src/module/quotation/features/quotations/components/legal-block-extension.ts
@@ -0,0 +1,155 @@
+import { Node, mergeAttributes } from '@tiptap/core';
+import { Plugin, PluginKey } from '@tiptap/pm/state';
+
+export interface LegalBlockOptions {
+  unlocked: boolean;
+  HTMLAttributes: Record<string, any>;
+}
+
+declare module '@tiptap/core' {
+  interface Commands<ReturnType> {
+    legalBlock: {
+      setLegalUnlocked: (unlocked: boolean) => ReturnType;
+    };
+  }
+}
+
+export const LegalBlockPluginKey = new PluginKey('legalBlockLock');
+
+export const LegalBlockExtension = Node.create<LegalBlockOptions>({
+  name: 'legalBlock',
+
+  group: 'block',
+
+  content: 'block+',
+
+  defining: true,
+
+  isolating: true,
+
+  addOptions() {
+    return {
+      unlocked: false,
+      HTMLAttributes: {},
+    };
+  },
+
+  addAttributes() {
+    return {
+      'data-block-type': {
+        default: 'legal',
+        parseHTML: (element) => element.getAttribute('data-block-type') || 'legal',
+        renderHTML: (attributes) => ({
+          'data-block-type': attributes['data-block-type'] || 'legal',
+        }),
+      },
+      'data-template-code': {
+        default: null,
+        parseHTML: (element) => element.getAttribute('data-template-code'),
+        renderHTML: (attributes) => {
+          if (!attributes['data-template-code']) return {};
+          return { 'data-template-code': attributes['data-template-code'] };
+        },
+      },
+      'data-modified': {
+        default: null,
+        parseHTML: (element) => element.getAttribute('data-modified'),
+        renderHTML: (attributes) => {
+          if (!attributes['data-modified']) return {};
+          return { 'data-modified': attributes['data-modified'] };
+        },
+      },
+    };
+  },
+
+  parseHTML() {
+    return [
+      {
+        tag: 'section[data-block-type="legal"]',
+        priority: 60,
+      },
+      {
+        tag: 'div[data-block-type="legal"]',
+        priority: 60,
+      },
+    ];
+  },
+
+  renderHTML({ HTMLAttributes }) {
+    return [
+      'section',
+      mergeAttributes(this.options.HTMLAttributes, HTMLAttributes, {
+        'data-block-type': 'legal',
+        class: `qtr-legal-block ${this.options.unlocked ? 'qtr-legal-unlocked' : 'qtr-legal-locked'}`,
+      }),
+      0,
+    ];
+  },
+
+  addCommands() {
+    return {
+      setLegalUnlocked:
+        (unlocked: boolean) =>
+        ({ tr, dispatch }) => {
+          this.options.unlocked = unlocked;
+          if (dispatch) {
+            tr.setMeta(LegalBlockPluginKey, { unlocked });
+          }
+          return true;
+        },
+    };
+  },
+
+  addProseMirrorPlugins() {
+    return [
+      new Plugin({
+        key: LegalBlockPluginKey,
+        filterTransaction: (tr, state) => {
+          // If extension option is unlocked, permit all transactions
+          if (this.options.unlocked) {
+            return true;
+          }
+
+          // If transaction does not change document content, permit (selection, cursor, meta)
+          if (!tr.docChanged) {
+            return true;
+          }
+
+          // Check if transaction has meta override
+          const meta = tr.getMeta(LegalBlockPluginKey);
+          if (meta?.unlocked) {
+            return true;
+          }
+
+          // Find all legal block ranges in current document
+          const legalRanges: Array<{ from: number; to: number }> = [];
+          state.doc.descendants((node, pos) => {
+            if (node.type.name === this.name) {
+              legalRanges.push({ from: pos, to: pos + node.nodeSize });
+            }
+          });
+
+          if (legalRanges.length === 0) {
+            return true;
+          }
+
+          // Check if any step touches any legal block range
+          let touchesLegal = false;
+          tr.steps.forEach((step) => {
+            const stepMap = step.getMap();
+            stepMap.forEach((oldStart, oldEnd) => {
+              for (const range of legalRanges) {
+                if (oldStart <= range.to && oldEnd >= range.from) {
+                  touchesLegal = true;
+                  break;
+                }
+              }
+            });
+          });
+
+          return !touchesLegal;
+        },
+      }),
+    ];
+  },
+});
